name = "Hhsqoo/cose"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/Hhsqoo/moon-cose"

license = "Apache-2.0"

keywords = [
  "cose",
  "cbor",
  "rfc9052",
  "rfc9053",
  "signature",
  "encryption",
  "hmac",
  "aes-gcm",
  "aes-ccm",
  "chacha20",
]

preferred_target = "native"

description = "COSE signing and encryption: Sign, Sign1, Mac, Mac0, Encrypt, Encrypt0, and COSE_Key"

import {
  "2515050242/cbor@0.1.2",
  "cc06b/mooncry@0.95.0",
}
